{
  "manifest_version": 3,
  "name": "Darkrai",
  "version": "1.0.0",
  "description": "Darkens sites that have no dark theme of their own, leaves the ones that do alone, and checks that text stays readable.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Darkrai",
    "default_icon": {
      "16": "icons/on-16.png",
      "32": "icons/on-32.png",
      "48": "icons/on-48.png",
      "128": "icons/on-128.png"
    }
  },
  "icons": {
    "16": "icons/on-16.png",
    "32": "icons/on-32.png",
    "48": "icons/on-48.png",
    "128": "icons/on-128.png"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-site": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Turn Darkrai on or off for this site"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shared/timing.js",
        "shared/color.js",
        "shared/settings.js",
        "shared/restricted.js",
        "content/detect.js",
        "content/engine-smart.js",
        "content/engine-simple.js",
        "content/readability.js",
        "content/icons.js",
        "content/picker.js",
        "content/main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "preload.css",
        "preload-system.css"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
